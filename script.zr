@syntax 2.0
@echo on

var APP = "demo"

env GREETING = "hello"

task hello --desc "打招呼" --on [windows, linux, macos] {
  echo $GREETING from $OS/$ARCH app=$APP args=$ARGS
}

task build --desc "构建示例" --deps [hello] --on [windows/amd64, linux, macos] {
  echo building $APP on $OS/$ARCH
}

task win-only --desc "仅 Windows" --on [windows] {
  echo windows-only $APP
}

task unix-only --desc "仅 Unix" --on [unix] {
  echo unix-only $APP
}
